{
  "manifest_version": 3,
  "name": "Flash Player",
  "version": "1.0",
  "description": "Alternative Player for Chromium Browsees",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["engine.js", "player.wasm", "embed.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
